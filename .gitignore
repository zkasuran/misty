/target
**/target
Cargo.lock.bak
*.profraw

# node / svelte
node_modules/
.svelte-kit/
build/
dist/
.vite/
*.tsbuildinfo

# tauri
apps/*/src-tauri/target/
apps/*/src-tauri/gen/

# secrets & local state — never commit
*.pem
*.key
*.p12
*.keystore
*.jks
.env
.env.*
!.env.example
/local/
*.mistyvault
*.mistybak

# fuzzing output. The corpus grows without bound and artifacts are crash inputs;
# neither belongs in git. Declared at the root as well as in each fuzz/.gitignore,
# because tools that walk the tree (reuse lint) do not all honour a nested ignore
# file inside an otherwise-untracked directory.
**/fuzz/corpus/
**/fuzz/artifacts/
**/fuzz/coverage/

# os
.DS_Store
Thumbs.db
